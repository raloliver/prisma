{
  "compilerOptions": {
    /* ESM baseline required by Prisma 7 */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "types": ["node"],
    "esModuleInterop": true,

    /* `tsc` is used for typechecking only; esbuild emits the runnable bundle.
       noEmit stops an accidental bare `tsc` from scattering output next to sources. */
    "noEmit": true,

    /* Stricter typechecking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Module interop hygiene */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}